<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MirrorDeck.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="MirrorDeck" Icon="Resources/MirrorDeck.ico" Height="820" Width="1120" MinHeight="580" MinWidth="800" WindowStartupLocation="CenterScreen" xmlns:app="clr-namespace:MirrorDeck.App;assembly=MirrorDeck.App" SourceInitialized="Window_SourceInitialized" Closing="Window_Closing" KeyDown="Window_KeyDown" MouseMove="Window_MouseMove">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="TopButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
      </Style>
      <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,8" />
      </Style>
      <Style x:Key="CompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="12,7" />
      </Style>
      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>
      <Style x:Key="PathTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SectionBlockStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Border.Padding" Value="0,8,0,24" />
        <Setter Property="Margin" Value="0,0,12,20" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00FFFFFF">
    <Grid.RowDefinitions>
      <RowDefinition Name="TopRow" Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Name="StatusRow" Height="30" />
    </Grid.RowDefinitions>
    <Border Name="TopBar" Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
      <Grid Margin="14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Resources/MirrorDeck.ico" Width="32" Height="32" Margin="6,0,12,0" />
          <TextBlock Text="MirrorDeck" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="TogglePreview_Click" MinWidth="128" Height="40" Margin="0,0,12,0">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Content" Value="Open preview" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsVideoRunning}" Value="True">
                    <Setter Property="Content" Value="Stop preview" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Style="{StaticResource TopButtonStyle}" ToolTip="Restart preview" AutomationProperties.Name="Restart preview" Click="RefreshDevices_Click">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" />
          </Button>
          <Button Style="{StaticResource TopButtonStyle}" ToolTip="Mute or unmute audio" AutomationProperties.Name="Mute or unmute audio" Click="ToggleMute_Click">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" />
          </Button>
          <Button Style="{StaticResource TopButtonStyle}" ToolTip="Preview fullscreen" AutomationProperties.Name="Preview fullscreen" IsEnabled="{Binding IsVideoRunning}" Click="ToggleFullscreen_Click">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" />
          </Button>
          <Button Style="{StaticResource TopButtonStyle}" ToolTip="Save visible preview to Pictures / MirrorDeck" AutomationProperties.Name="Save preview screenshot" IsEnabled="{Binding IsVideoRunning}" Click="Screenshot_Click">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Name="SettingsPanel" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0">
      <TabControl Margin="0">
        <TabItem Header="Capture + Audio">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,16">
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Capture Device" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Source type" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox DisplayMemberPath="Name" SelectedValuePath="Value" ItemsSource="{Binding CaptureSourceTypes}" SelectedValue="{Binding Settings.CaptureSourceType, Mode=TwoWay}" SelectionChanged="SourceTypeCombo_SelectionChanged" />
                  <TextBlock Text="Source" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding VideoDevices}" SelectedItem="{Binding SelectedVideoDevice, Mode=TwoWay}" SelectionChanged="VideoDeviceCombo_SelectionChanged" />
                  <CheckBox Content="Capture mouse pointer" IsChecked="{Binding Settings.CaptureOverlay.CaptureMousePointer, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  <TextBlock Text="Input format" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding VideoFormats}" SelectedItem="{Binding SelectedVideoFormat, Mode=TwoWay}" SelectionChanged="VideoFormatCombo_SelectionChanged" />
                  <WrapPanel Margin="0,16,0,0">
                    <Button Style="{StaticResource ActionButtonStyle}" Click="AutoFormat_Click">Auto Format</Button>
                    <Button Style="{StaticResource CompactButtonStyle}" ToolTip="Rescan connected capture devices and available input formats" AutomationProperties.Name="Rescan devices" Click="RescanDevices_Click">
                      <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Audio" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Input" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDevice, Mode=TwoWay}" SelectionChanged="AudioEndpointComboChanged" />
                  <TextBlock Text="Output" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}" SelectionChanged="AudioEndpointComboChanged" />
                  <TextBlock Text="Volume" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="0" Maximum="2" Value="{Binding Settings.Audio.Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="AudioSliderChanged" />
                  <CheckBox Content="Muted" IsChecked="{Binding Settings.Audio.Muted, Mode=TwoWay}" Click="AudioSettingChanged" />
                  <TextBlock Text="Delay offset (ms)" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="-200" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.Audio.DelayMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="AudioSliderChanged" />
                  <TextBlock Text="Channel mode" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding AudioChannelModes}" SelectedItem="{Binding Settings.Audio.ChannelMode, Mode=TwoWay}" SelectionChanged="AudioComboChanged" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Image">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,16">
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Image Enhancements" Style="{StaticResource SectionTitleStyle}" />
                  <CheckBox Content="Enable image enhancements" Margin="0,0,0,10" IsChecked="{Binding Settings.Enhancement.Enabled, Mode=TwoWay}" Click="ImageEnhancementSettingChanged" />
                  <StackPanel IsEnabled="{Binding Settings.Enhancement.Enabled}">
                    <TextBlock Text="Scaling filter" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ScalingFilterCombo" ItemsSource="{Binding ScalingFilters}" SelectedItem="{Binding Settings.Scaling.Filter, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="Native DLSS uses estimated motion and flat depth. ReShade must be uninstalled for native DLSS. FSR EASU: general footage. Anime line art: line thinning. Sharp bilinear: pixel art." />
                    <StackPanel x:Name="NeuralControls" Margin="0,16,0,12">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScalingFilterCombo}" Value="Dlss5">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="Neural rendering" Style="{StaticResource SectionTitleStyle}" />
                      <TextBlock Text="Repeat neural rendering" Style="{StaticResource FieldLabelStyle}" />
                      <ComboBox x:Name="NeuralPassesCombo" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Count" ItemsSource="{Binding NeuralPassOptions}" SelectedValue="{Binding Settings.Scaling.Neural.Passes, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="Off uses one normal pass. 2x, 3x and 4x reapply the neural effect with separate histories. More passes increase GPU time and VRAM and may reduce FPS or exaggerate artifacts." />
                      <TextBlock Text="Working resolution" Style="{StaticResource FieldLabelStyle}" />
                      <ComboBox ItemsSource="{Binding NeuralWorkHeights}" SelectedItem="{Binding Settings.Scaling.Neural.WorkHeight, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="Height in pixels processed by the neural model. Lower values reduce GPU cost. Source detail is composited back at input resolution; FSR EASU scales the result to the preview." />
                      <UniformGrid Columns="2" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,8,0">
                          <TextBlock Text="Style" Style="{StaticResource FieldLabelStyle}" />
                          <ComboBox ItemsSource="{Binding NeuralStyles}" SelectedItem="{Binding Settings.Scaling.Neural.Style, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                          <TextBlock Text="Model preset hint" Style="{StaticResource FieldLabelStyle}" />
                          <ComboBox ItemsSource="{Binding NeuralPresets}" SelectedItem="{Binding Settings.Scaling.Neural.Preset, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="Runtime model hint. This experimental runtime may ignore some presets. Changing the hint rebuilds neural history, not capture." />
                        </StackPanel>
                      </UniformGrid>
                      <DockPanel Margin="0,16,0,0">
                        <TextBlock Text="NR intensity" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=NrIntensity, StringFormat={}{0:F2}}" />
                      </DockPanel>
                      <Slider x:Name="NrIntensity" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Settings.Scaling.Neural.Intensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" ToolTip="0 bypasses neural evaluation while keeping its resources ready for comparison." />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Local tone strength" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=NrTone, StringFormat={}{0:F2}}" />
                      </DockPanel>
                      <Slider x:Name="NrTone" Minimum="0" Maximum="2" Value="{Binding Settings.Scaling.Neural.LocalTone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Local structure strength" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=NrStructure, StringFormat={}{0:F2}}" />
                      </DockPanel>
                      <Slider x:Name="NrStructure" Minimum="0" Maximum="2" Value="{Binding Settings.Scaling.Neural.LocalStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Skin structure strength" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=NrSkin, StringFormat={}{0:F2}}" />
                      </DockPanel>
                      <Slider x:Name="NrSkin" Minimum="-1" Maximum="1" Value="{Binding Settings.Scaling.Neural.SkinStructure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" ToolTip="-1 inherits the runtime default." />
                      <CheckBox Content="Automatic mask" IsChecked="{Binding Settings.Scaling.Neural.AutomaticMask, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                      <CheckBox Content="UI correction" IsChecked="{Binding Settings.Scaling.Neural.UiCorrection, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Color strength" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=NrColor, StringFormat={}{0:P0}}" />
                      </DockPanel>
                      <Slider x:Name="NrColor" Minimum="0" Maximum="1" Value="{Binding Settings.Scaling.Neural.ColorStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Effect blend" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding Value, ElementName=NrBlend, StringFormat={}{0:P0}}" />
                      </DockPanel>
                      <Slider x:Name="NrBlend" Minimum="0" Maximum="1" Value="{Binding Settings.Scaling.Neural.Blend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,8">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScalingFilterCombo}" Value="Dlss45">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="DLSS output resolution" Style="{StaticResource FieldLabelStyle}" />
                      <ComboBox x:Name="DlssOutputResolutionCombo" ItemsSource="{Binding DlssOutputResolutions}" SelectedItem="{Binding Settings.Scaling.DlssOutputResolution, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="Upscale the selected capture input to this resolution without changing its device mode. Fixed targets are processed at the selected size even in a smaller preview; aspect ratio is preserved. Higher targets increase GPU cost. Monitor size follows the preview window's monitor." />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="DLSS sharpness" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding Value, ElementName=DlssSharpnessSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" />
                      </DockPanel>
                      <Slider x:Name="DlssSharpnessSlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Settings.Scaling.DlssSharpness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" ToolTip="Sharpen the native DLSS output live. 0% adds no sharpening. This uses MirrorDeck's GPU post-processing, not NVIDIA's deprecated DLSS sharpness parameter." />
                      <TextBlock Text="DLSS model" Margin="0,12,0,6" Style="{StaticResource FieldLabelStyle}" />
                      <ComboBox x:Name="DlssModelCombo" ItemsSource="{Binding DlssModels}" SelectedItem="{Binding Settings.Scaling.DlssModel, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="Auto selects M for Performance, L for Ultra Performance, and K for other ratios. M remains the default. L is not always better than M. Changes briefly rebuild DLSS history; the source resolution stays unchanged." />
                      <TextBlock Text="Motion estimation" Margin="0,12,0,6" Style="{StaticResource FieldLabelStyle}" />
                      <ComboBox x:Name="DlssMotionQualityCombo" ItemsSource="{Binding DlssMotionQualities}" SelectedItem="{Binding Settings.Scaling.DlssMotionQuality, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" ToolTip="High uses NVIDIA Optical Flow's slow, higher-quality preset. It can improve estimated movement but costs GPU time. Changes briefly rebuild processing resources." />
                      <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Text / detail protection" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding Value, ElementName=DlssDetailProtectionSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" />
                      </DockPanel>
                      <Slider x:Name="DlssDetailProtectionSlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Settings.Scaling.DlssDetailProtection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" ToolTip="100% preserves the current text-stability protection. Lower values let DLSS reconstruct more fine strokes but may reintroduce text breakup. Motion and scene-change safeguards remain active. Updates live." />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,8">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScalingFilterCombo}" Value="SharpBilinear">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScalingFilterCombo}" Value="FsrEasu">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScalingFilterCombo}" Value="AnimeLineArt">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <DockPanel>
                        <TextBlock Text="Upscale strength" Style="{StaticResource FieldLabelStyle}" />
                        <TextBlock Text="{Binding Value, ElementName=UpscaleStrengthSlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" />
                      </DockPanel>
                      <Slider x:Name="UpscaleStrengthSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Settings.Scaling.UpscaleStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" ToolTip="Blend from bilinear at 0% to the selected upscaler at 100%. Active only when enlarging the source." />
                    </StackPanel>
                    <CheckBox Content="Integer scaling" IsChecked="{Binding Settings.Scaling.IntegerScaling, Mode=TwoWay}" Click="LayoutSettingChanged" />
                    <CheckBox Content="Black bars" IsChecked="{Binding Settings.Scaling.BlackBars, Mode=TwoWay}" Click="LayoutSettingChanged" />
                    <StackPanel>
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=ScalingFilterCombo}" Value="Dlss45">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Text="Sharpness" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                      <Slider Minimum="0" Maximum="1" Value="{Binding Settings.Scaling.Sharpness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                    </StackPanel>
                    <CheckBox Content="Debanding" IsChecked="{Binding Settings.Scaling.Debanding, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}" IsEnabled="{Binding Settings.Enhancement.Enabled}">
                <StackPanel>
                  <TextBlock Text="Cleanup" Style="{StaticResource SectionTitleStyle}" />
                  <CheckBox Content="Edge cleaning" IsChecked="{Binding Settings.Enhancement.CleanUpscalingEnabled, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  <TextBlock Text="Clean strength" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="0" Maximum="1" Value="{Binding Settings.Enhancement.CleanUpscalingStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                  <TextBlock Text="Denoise" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="0" Maximum="1" Value="{Binding Settings.Enhancement.Denoise, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                  <TextBlock Text="Edge restore" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="0" Maximum="1" Value="{Binding Settings.Enhancement.EdgeRestore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Display">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,16">
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Preview sizing" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Text="Spatial / ReShade processing resolution" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox DisplayMemberPath="Name" SelectedValuePath="Height" ToolTip="Limits the resolution processed by spatial filters and ReShade. Lower values reduce GPU load; fullscreen still fills the display. Native DLSS bypasses this cap so its output reaches the full preview surface." ItemsSource="{Binding ProcessingResolutions}" SelectedValue="{Binding Settings.Output.ProcessingMaxHeight, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" />
                  <TextBlock Text="Preview window size" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding OutputResolutionModes}" SelectedItem="{Binding Settings.Output.ResolutionMode, Mode=TwoWay}" SelectionChanged="LayoutSettingChanged" />
                  <UniformGrid Columns="2" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Text="Custom width" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Output.CustomWidth, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" LostFocus="LayoutSettingChanged" />
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Text="Custom height" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Output.CustomHeight, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" LostFocus="LayoutSettingChanged" />
                    </StackPanel>
                  </UniformGrid>
                  <CheckBox Content="Preserve aspect ratio" IsChecked="{Binding Settings.Output.PreserveAspectRatio, Mode=TwoWay}" Click="LayoutSettingChanged" />
                  <TextBlock Text="Fill mode" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding AspectModes}" SelectedItem="{Binding Settings.Output.AspectMode, Mode=TwoWay}" SelectionChanged="LayoutSettingChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Preview Window" Style="{StaticResource SectionTitleStyle}" />
                  <CheckBox Content="Always on top" IsChecked="{Binding Settings.PreviewWindow.AlwaysOnTop, Mode=TwoWay}" Click="WindowSettingChanged" />
                  <CheckBox Content="Borderless window" IsChecked="{Binding Settings.PreviewWindow.Borderless, Mode=TwoWay}" Click="WindowSettingChanged" />
                  <TextBlock Text="Window opacity" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="0.35" Maximum="1" Value="{Binding Settings.PreviewWindow.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="OpacitySlider_ValueChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Responsiveness" Style="{StaticResource SectionTitleStyle}" />
                  <CheckBox Content="Low-latency mode" ToolTip="Prefer the newest captured frame. Turn off to use timestamped frame buffering for smoother delivery." IsChecked="{Binding Settings.Latency.LowLatencyMode, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  <TextBlock Text="Frame buffering" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding FrameBufferOptions}" SelectedItem="{Binding Settings.Latency.FrameBufferCount, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" />
                  <CheckBox Content="V-sync" IsChecked="{Binding Settings.Latency.VSyncEnabled, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  <CheckBox Content="Drop late frames" IsChecked="{Binding Settings.Latency.DropLateFrames, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  <TextBlock Text="FPS cap (0 = uncapped)" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <TextBox Text="{Binding Settings.Latency.FpsCap, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="PreviewLatencyTextBox_LostFocus" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Capture Overlay" Style="{StaticResource SectionTitleStyle}" />
                  <CheckBox Content="Show framerate overlay" IsChecked="{Binding Settings.CaptureOverlay.ShowFramerate, Mode=TwoWay}" Click="PreviewProcessingSettingChanged" />
                  <TextBlock Text="Corner" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <ComboBox ItemsSource="{Binding OverlayCorners}" SelectedItem="{Binding Settings.CaptureOverlay.FramerateCorner, Mode=TwoWay}" SelectionChanged="PreviewProcessingComboChanged" />
                  <TextBlock Text="Size" Margin="0,14,0,6" Style="{StaticResource FieldLabelStyle}" />
                  <Slider Minimum="0.75" Maximum="2" Value="{Binding Settings.CaptureOverlay.FramerateScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="PreviewProcessingSliderChanged" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Profiles">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,16">
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Built-in profiles" Style="{StaticResource SectionTitleStyle}" />
                  <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ActionButtonStyle}" Content="{Binding Name}" Click="PresetButton_Click" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Saved profiles" Style="{StaticResource SectionTitleStyle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox MinWidth="260" Margin="0,0,8,0" Text="{Binding ConfigName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Save Current" Style="{StaticResource CompactButtonStyle}" Click="SaveConfig_Click" />
                    <Button Grid.Column="2" Content="Refresh" Style="{StaticResource CompactButtonStyle}" Margin="0" Click="RefreshConfigs_Click" />
                  </Grid>
                  <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding SavedConfigs}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,8">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                              <TextBlock Style="{StaticResource PathTextStyle}" Margin="0,3,0,0" Text="{Binding UpdatedText}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Load" Style="{StaticResource CompactButtonStyle}" Click="LoadConfig_Click" />
                            <Button Grid.Column="2" Content="Delete" Style="{StaticResource CompactButtonStyle}" Margin="0" Click="DeleteConfig_Click" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Config folder" Margin="0,8,0,4" Style="{StaticResource FieldLabelStyle}" />
                  <TextBlock Style="{StaticResource PathTextStyle}" Text="{Binding ConfigsPath}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Advanced">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,10,0,16">
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Startup" Style="{StaticResource SectionTitleStyle}" />
                  <CheckBox Content="Open last device automatically" IsChecked="{Binding Settings.OpenLastDeviceOnStartup, Mode=TwoWay}" />
                  <CheckBox Content="Start fullscreen" IsChecked="{Binding Settings.StartFullscreen, Mode=TwoWay}" />
                  <CheckBox Content="Start muted" IsChecked="{Binding Settings.StartMuted, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Maintenance" Style="{StaticResource SectionTitleStyle}" />
                  <WrapPanel>
                    <Button Style="{StaticResource ActionButtonStyle}" Click="Screenshot_Click">Screenshot</Button>
                    <Button Style="{StaticResource ActionButtonStyle}" Click="SaveSettings_Click">Save Settings</Button>
                    <Button Style="{StaticResource ActionButtonStyle}" Click="OpenLog_Click">Open Log File</Button>
                  </WrapPanel>
                  <TextBlock Text="Settings file" Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" />
                  <TextBlock Style="{StaticResource PathTextStyle}" Text="{Binding SettingsPath}" />
                  <TextBlock Text="Log file" Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" />
                  <TextBlock Style="{StaticResource PathTextStyle}" Text="{Binding LogPath}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}">
                <StackPanel>
                  <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitleStyle}" />
                  <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="360" FontFamily="Cascadia Mono, Consolas" FontSize="11" Text="{Binding DiagnosticText}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource SectionBlockStyle}" Margin="0,10,10,12">
                <StackPanel>
                  <TextBlock Text="Hotkeys" Style="{StaticResource SectionTitleStyle}" />
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,12">
                      <TextBlock Text="Fullscreen" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Hotkeys.Fullscreen, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="HotkeyTextBox_LostFocus" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,12">
                      <TextBlock Text="Mute" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Hotkeys.Mute, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="HotkeyTextBox_LostFocus" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,12">
                      <TextBlock Text="Stats overlay" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Hotkeys.StatsOverlay, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="HotkeyTextBox_LostFocus" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,12">
                      <TextBlock Text="Always on top" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Hotkeys.AlwaysOnTop, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="HotkeyTextBox_LostFocus" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Text="Screenshot" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Hotkeys.Screenshot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="HotkeyTextBox_LostFocus" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Text="Relaunch preview" Style="{StaticResource FieldLabelStyle}" />
                      <TextBox Text="{Binding Settings.Hotkeys.RelaunchPreview, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" LostFocus="HotkeyTextBox_LostFocus" />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Updates" Tag="&#xE895;">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,20">
              <TextBlock Text="Updates" Style="{StaticResource SectionTitleStyle}" />
              <CheckBox Content="Check for updates at startup" IsChecked="{Binding Settings.CheckForUpdatesOnStartup, Mode=TwoWay}" Margin="0,0,0,16" />
              <StackPanel DataContext="{Binding Updates, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Text="{Binding CurrentVersion, StringFormat=Installed version: {0}}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
                <WrapPanel Margin="0,0,0,12">
                  <Button Content="Check for updates" Style="{StaticResource ActionButtonStyle}" Click="CheckUpdates_Click" IsEnabled="{Binding CanCheck}" Margin="0,0,8,8" />
                  <Button Content="Download update" Style="{StaticResource ActionButtonStyle}" Click="DownloadUpdate_Click" IsEnabled="{Binding CanDownload}" Margin="0,0,8,8" />
                  <Button Content="Install and restart" Style="{StaticResource ActionButtonStyle}" Click="InstallUpdate_Click" IsEnabled="{Binding CanInstall}" Margin="0,0,8,8" />
                  <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Click="CancelUpdate_Click" IsEnabled="{Binding Busy}" Margin="0,0,0,8" />
                </WrapPanel>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,0,0,12" />
                <TextBlock Text="{Binding LastChecked, StringFormat=Last checked: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20" />
                <TextBlock Text="Connection sources" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="GitHub / EDMIRE2k / MirrorDeck" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="api.github.com - Release information" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="github.com/EDMIRE2k/MirrorDeck - Release downloads" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="release-assets.githubusercontent.com - GitHub file delivery" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="View GitHub releases" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" Click="OpenReleasePage_Click" Margin="0,0,0,16" />
                <TextBlock Text="Last connection" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Connection, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Release download URL" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding DownloadUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="GitHub SHA-256" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Sha256, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,20" />
                <TextBlock Text="Release notes" Style="{StaticResource SectionTitleStyle}" />
                <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="280" VerticalScrollBarVisibility="Auto" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>
    <Border Name="StatusBar" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" MaxWidth="310" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Gpu.Name}" ToolTip="{Binding Gpu.Name}" />
      </Grid>
    </Border>
  </Grid>
</Window>

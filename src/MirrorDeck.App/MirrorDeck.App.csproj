<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MirrorDeck.App</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="MirrorDeck.App\App.xaml" />
    <ApplicationDefinition Include="MirrorDeck.App\App.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="app.xaml" />
    <Page Remove="MirrorDeck.App\MainWindow.xaml" />
    <Page Include="MirrorDeck.App\MainWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="mainwindow.xaml" />
    <Resource Remove="resources\mirrordeck.ico" />
    <Resource Include="resources\mirrordeck.ico" LogicalName="resources/mirrordeck.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MirrorDeck.Core\MirrorDeck.Core.csproj" />
    <Reference Include="Vortice.Direct3D12"><HintPath>..\..\lib\Vortice.Direct3D12.dll</HintPath></Reference>
    <Reference Include="Vortice.DXGI"><HintPath>..\..\lib\Vortice.DXGI.dll</HintPath></Reference>
    <Reference Include="Vortice.DirectX"><HintPath>..\..\lib\Vortice.DirectX.dll</HintPath></Reference>
    <Reference Include="Vortice.Mathematics"><HintPath>..\..\lib\Vortice.Mathematics.dll</HintPath></Reference>
    <Reference Include="SharpGen.Runtime"><HintPath>..\..\lib\SharpGen.Runtime.dll</HintPath></Reference>
    <ProjectReference Include="..\MirrorDeck.Settings\MirrorDeck.Settings.csproj" />
    <ProjectReference Include="..\MirrorDeck.Rendering\MirrorDeck.Rendering.csproj" />
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>..\..\lib\CommunityToolkit.Mvvm.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\MirrorDeck.Capture\MirrorDeck.Capture.csproj" />
    <ProjectReference Include="..\MirrorDeck.Audio\MirrorDeck.Audio.csproj" />
  </ItemGroup>
</Project>

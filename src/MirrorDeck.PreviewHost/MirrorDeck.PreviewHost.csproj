<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MirrorDeck.PreviewHost</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ApplicationConfiguration.cs" />
    <EmbeddedResource Include="Shaders\**\*.h;Shaders\**\*.hlsl" />
    <None Remove="MirrorDeck.PreviewHost.Resources.MirrorDeck.PreviewHost.ico" />
    <EmbeddedResource Include="MirrorDeck.PreviewHost.Resources.MirrorDeck.PreviewHost.ico" LogicalName="MirrorDeck.PreviewHost.Resources.MirrorDeck.PreviewHost.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="DirectShowLib">
      <HintPath>..\..\lib\DirectShowLib.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.Direct3D11">
      <HintPath>..\..\lib\Vortice.Direct3D11.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.DXGI">
      <HintPath>..\..\lib\Vortice.DXGI.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.DirectX">
      <HintPath>..\..\lib\Vortice.DirectX.dll</HintPath>
    </Reference>
    <Reference Include="SharpGen.Runtime">
      <HintPath>..\..\lib\SharpGen.Runtime.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\MirrorDeck.Core\MirrorDeck.Core.csproj" />
    <Reference Include="Vortice.Mathematics">
      <HintPath>..\..\lib\Vortice.Mathematics.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\MirrorDeck.Rendering\MirrorDeck.Rendering.csproj" />
    <Reference Include="Vortice.Direct3D12">
      <HintPath>..\..\lib\Vortice.Direct3D12.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\MirrorDeck.Settings\MirrorDeck.Settings.csproj" />
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>..\..\lib\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="Vortice.D3DCompiler">
      <HintPath>..\..\lib\Vortice.D3DCompiler.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>..\..\lib\WinRT.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
